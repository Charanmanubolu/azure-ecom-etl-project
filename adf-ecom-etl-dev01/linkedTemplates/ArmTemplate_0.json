		{
			"name": "[concat(parameters('factoryName'), '/PL_BULK_TO_RAW')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Get_Bulk_Files",
						"type": "GetMetadata",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"dataset": {
								"referenceName": "DS_BLOB_FOLDER",
								"type": "DatasetReference",
								"parameters": {
									"FolderPath": "Bulk_files"
								}
							},
							"fieldList": [
								"childItems"
							],
							"storeSettings": {
								"type": "AzureBlobFSReadSettings",
								"recursive": true,
								"enablePartitionDiscovery": false
							},
							"formatSettings": {
								"type": "BinaryReadSettings"
							}
						}
					},
					{
						"name": "Filter_Bulk_CSV_Files",
						"type": "Filter",
						"dependsOn": [
							{
								"activity": "Get_Bulk_Files",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('Get_Bulk_Files').output.childItems",
								"type": "Expression"
							},
							"condition": {
								"value": "@and(equals(item().type,'File'),endsWith(toLower(item().name),'.csv'))",
								"type": "Expression"
							}
						}
					},
					{
						"name": "ForEach_Bulk_CSV",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "Filter_Bulk_CSV_Files",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
