														"dependsOn": [],
														"policy": {
															"timeout": "0.12:00:00",
															"retry": 2,
															"retryIntervalInSeconds": 30
														},
														"userProperties": [],
														"typeProperties": {
															"source": {
																"type": "JsonSource",
																"storeSettings": {
																	"type": "AzureBlobFSReadSettings",
																	"recursive": false
																},
																"formatSettings": {
