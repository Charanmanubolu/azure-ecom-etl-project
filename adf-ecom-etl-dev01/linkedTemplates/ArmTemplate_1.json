																		"value": "@item().name",
																		"type": "Expression"
																	},
																	"FolderPath": "@pipeline().parameters.pSourceFolder"
																}
															}
														],
														"outputs": [
															{
																"referenceName": "DS_RAW_PARQUET",
																"type": "DatasetReference",
																"parameters": {
																	"EntityName": {
																		"value": "@substring(item().name,0,lastIndexOf(item().name,'.'))",
																		"type": "Expression"
																	},
																	"YEAR": {
																		"value": "@formatDateTime(utcNow(),'yyyy')",
																		"type": "Expression"
																	},
																	"MONTH": {
																		"value": "@formatDateTime(utcNow(),'MM')",
																		"type": "Expression"
																	},
																	"DAY": {
																		"value": "@formatDateTime(utcNow(),'dd')",
																		"type": "Expression"
																	}
																}
