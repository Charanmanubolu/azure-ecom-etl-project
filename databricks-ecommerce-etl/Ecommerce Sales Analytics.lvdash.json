{
  "datasets": [
    {
      "name": "orders",
      "displayName": "Orders",
      "config": {
        "source": "adb_ecom_dev_01.gold.fact_orders",
        "measures": [
          {
            "name": "total_orders",
            "expr": "COUNT(DISTINCT source.order_id)",
            "format": {
              "type": "number",
              "abbreviation": "compact"
            }
          },
          {
            "name": "total_customers",
            "expr": "COUNT(DISTINCT customer.customer_unique_id)",
            "format": {
              "type": "number",
              "abbreviation": "compact"
            }
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "name": "order_date",
            "expr": "dt.full_date"
          },
          {
            "name": "order_month",
            "expr": "DATE_TRUNC('MONTH', dt.full_date)"
          },
          {
            "name": "customer_state",
            "expr": "customer.customer_state"
          },
          {
            "name": "order_status",
            "expr": "source.order_status"
          }
        ],
        "joins": [
          {
            "name": "customer",
            "source": "adb_ecom_dev_01.gold.dim_customer",
            "on": "source.customer_key = customer.customer_key"
          },
          {
            "name": "dt",
            "source": "adb_ecom_dev_01.gold.dim_date",
            "on": "source.purchase_date_key = dt.date_key"
          }
        ]
      }
    },
    {
      "name": "reviews",
      "displayName": "Reviews",
      "config": {
        "source": "adb_ecom_dev_01.gold.fact_order_reviews",
        "measures": [
          {
            "name": "avg_review_score",
            "expr": "AVG(source.review_score)",
            "format": {
              "type": "number",
              "decimalPlaces": {
                "type": "exact",
                "places": 2.0
              }
            }
          },
          {
            "name": "review_count",
            "expr": "COUNT(DISTINCT source.review_id)"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "name": "review_date",
            "expr": "dt.full_date"
          },
          {
            "name": "review_month",
            "expr": "DATE_TRUNC('MONTH', dt.full_date)"
          },
          {
            "name": "customer_state",
            "expr": "customer.customer_state"
          }
        ],
        "joins": [
          {
            "name": "customer",
            "source": "adb_ecom_dev_01.gold.dim_customer",
            "on": "source.customer_key = customer.customer_key"
          },
          {
            "name": "dt",
            "source": "adb_ecom_dev_01.gold.dim_date",
            "on": "source.review_creation_date_key = dt.date_key"
          }
        ]
      }
    },
    {
      "name": "order_items",
      "displayName": "Order Items Sales",
      "config": {
        "source": "adb_ecom_dev_01.gold.fact_order_items",
        "measures": [
          {
            "name": "total_revenue",
            "expr": "SUM(source.item_total)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "compact"
            }
          },
          {
            "name": "orders",
            "expr": "COUNT(DISTINCT source.order_id)"
          },
          {
            "name": "items_sold",
            "expr": "COUNT(1)"
          },
          {
            "name": "avg_order_value",
            "expr": "SUM(source.item_total) / COUNT(DISTINCT source.order_id)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL"
            }
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "name": "order_date",
            "expr": "dt.full_date"
          },
          {
            "name": "order_month",
            "expr": "DATE_TRUNC('MONTH', dt.full_date)"
          },
          {
            "name": "customer_state",
            "expr": "customer.customer_state"
          },
          {
            "name": "customer_unique_id",
            "expr": "customer.customer_unique_id"
          },
          {
            "name": "product_category",
            "expr": "COALESCE(product.product_category_name_english, product.product_category_name, 'Unknown')"
          },
          {
            "name": "product_id",
            "expr": "product.product_id"
          },
          {
            "name": "seller_id",
            "expr": "seller.seller_id"
          },
          {
            "name": "seller_state",
            "expr": "seller.seller_state"
          }
        ],
        "joins": [
          {
            "name": "product",
            "source": "adb_ecom_dev_01.gold.dim_product",
            "on": "source.product_key = product.product_key"
          },
          {
            "name": "seller",
            "source": "adb_ecom_dev_01.gold.dim_seller",
            "on": "source.seller_key = seller.seller_key"
          },
          {
            "name": "customer",
            "source": "adb_ecom_dev_01.gold.dim_customer",
            "on": "source.customer_key = customer.customer_key"
          },
          {
            "name": "dt",
            "source": "adb_ecom_dev_01.gold.dim_date",
            "on": "source.purchase_date_key = dt.date_key"
          }
        ]
      }
    },
    {
      "name": "payments",
      "displayName": "Payments",
      "config": {
        "source": "adb_ecom_dev_01.gold.fact_order_payments",
        "measures": [
          {
            "name": "payment_value",
            "expr": "SUM(source.payment_value)",
            "format": {
              "type": "currency",
              "currencyCode": "BRL",
              "abbreviation": "compact"
            }
          },
          {
            "name": "payment_orders",
            "expr": "COUNT(DISTINCT source.order_id)"
          }
        ],
        "version": "1.1",
        "dimensions": [
          {
            "name": "order_date",
            "expr": "dt.full_date"
          },
          {
            "name": "customer_state",
            "expr": "customer.customer_state"
          },
          {
            "name": "payment_type",
            "expr": "source.payment_type"
          }
        ],
        "joins": [
          {
            "name": "customer",
            "source": "adb_ecom_dev_01.gold.dim_customer",
            "on": "source.customer_key = customer.customer_key"
          },
          {
            "name": "dt",
            "source": "adb_ecom_dev_01.gold.dim_date",
            "on": "source.purchase_date_key = dt.date_key"
          }
        ]
      }
    }
  ],
