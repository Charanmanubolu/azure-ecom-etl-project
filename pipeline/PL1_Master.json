{
	"name": "PL1_Master",
	"properties": {
		"activities": [
			{
				"name": "Set_Trigger_Variable",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Trigger_variable",
					"value": {
						"value": "@if(equals(pipeline().parameters.Trigger, null), pipeline().TriggerName, pipeline().parameters.Trigger)\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Switch_Source",
				"type": "Switch",
				"dependsOn": [
					{
						"activity": "Set_Trigger_Variable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"on": {
						"value": "@toUpper(variables('Trigger_variable'))",
						"type": "Expression"
					},
					"cases": [
						{
							"value": "SQL",
							"activities": [
								{
									"name": "Execute_SQL_To_RAW",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_SQL_TO_RAW",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true
									}
								}
							]
						},
						{
							"value": "RESTAPI",
							"activities": [
								{
									"name": "Execute_RESTAPI_To_RAW",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_RESTAPI_TO_RAW",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"pEntityName": "retool_data",
											"pApiUrl": "https://retoolapi.dev/WL6Gkn/data"
										}
									}
								}
							]
						},
						{
							"value": "CSV",
							"activities": [
								{
									"name": "Execute_CSV_To_RAW",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_CSV_TO_RAW",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"pSourceFolder": "csv_files"
										}
									}
								}
							]
						},
						{
							"value": "EXCEL",
							"activities": [
								{
									"name": "Execute_EXCEL_To_RAW",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_EXCEL_TO_RAW",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"pSourceFolder": "excel_files"
										}
									}
								}
							]
						},
						{
							"value": "BULK",
							"activities": [
								{
									"name": "Execute_BULK_To_RAW",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_BULK_TO_RAW",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"pSourceFolder": "Bulk_files"
										}
									}
								}
							]
						},
						{
							"value": "SFTP",
							"activities": [
								{
									"name": "Execute_SFTP_To_RAW",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_SFTP_TO_RAW",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"pSourceFolder": "SFTP_files"
										}
									}
								}
							]
						},
						{
							"value": "SNOWFLAKE",
							"activities": [
								{
									"name": "Execute_SNOWFLAKE_Metadata",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "PL_SNOWFLAKE_METADATA_ORCHESTRATOR",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"DatabaseName": "DBAZURESNOW"
										}
									}
								}
							]
						}
					],
					"defaultActivities": [
						{
							"name": "Fail_Unsupported_Trigger",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "Unsupported Trigger value. Use SQL, RESTAPI, CSV, EXCEL, BULK, SFTP, or SNOWFLAKE.",
								"errorCode": "UNSUPPORTED_TRIGGER"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"Trigger": {
				"type": "String"
			}
		},
		"variables": {
			"Trigger_variable": {
				"type": "String"
			}
		},
		"annotations": []
	}
}