{
  "name": "PL_EXCEL_TO_RAW",
  "properties": {
    "activities": [
      {
        "name": "GM_List_Of_Files",
        "type": "GetMetadata",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "dataset": {
            "referenceName": "DS_BLOB_FOLDER",
            "type": "DatasetReference",
            "parameters": {
              "FolderPath": {
                "value": "@pipeline().parameters.pSourceFolder",
                "type": "Expression"
              }
            }
          },
          "fieldList": [
            "childItems"
          ],
          "storeSettings": {
            "type": "AzureBlobFSReadSettings",
            "recursive": false,
            "enablePartitionDiscovery": false
          },
          "formatSettings": {
            "type": "BinaryReadSettings"
          }
        }
      },
      {
        "name": "FL_Filter_Excel_Files",
        "type": "Filter",
        "dependsOn": [
          {
            "activity": "GM_List_Of_Files",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "userProperties": [],
        "typeProperties": {
          "items": {
            "value": "@activity('GM_List_Of_Files').output.childItems",
            "type": "Expression"
          },
          "condition": {
            "value": "@and(equals(item().type,'File'),or(endsWith(toLower(item().name),'.xlsx'),endsWith(toLower(item().name),'.xls')))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "FE_Process_Excel_Files",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "FL_Filter_Excel_Files",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "userProperties": [],
        "typeProperties": {
          "items": {
            "value": "@activity('FL_Filter_Excel_Files').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "activities": [
            {
              "name": "CP_Excel_To_Raw",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "source": {
                  "type": "ExcelSource",
                  "storeSettings": {
                    "type": "AzureBlobFSReadSettings",
                    "recursive": false,
                    "enablePartitionDiscovery": false
                  }
                },
                "sink": {
                  "type": "ParquetSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings"
                  },
                  "formatSettings": {
                    "type": "ParquetWriteSettings"
                  }
                },
                "enableStaging": false,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": true,
                    "treatBooleanAsNumber": false
                  }
                }
              },
              "inputs": [
                {
                  "referenceName": "DS_EXCEL",
                  "type": "DatasetReference",
                  "parameters": {
                    "FileName": {
                      "value": "@item().name",
                      "type": "Expression"
                    },
                    "FolderPath": {
                      "value": "@pipeline().parameters.pSourceFolder",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "DS_RAW_PARQUET",
                  "type": "DatasetReference",
                  "parameters": {
                    "EntityName": {
                      "value": "@replace(replace(replace(toLower(item().name),'.xlsx',''),'.xls',''),'_dataset','')",
                      "type": "Expression"
                    },
                    "YEAR": {
                      "value": "@formatDateTime(utcNow(),'yyyy')",
                      "type": "Expression"
                    },
                    "MONTH": {
                      "value": "@formatDateTime(utcNow(),'MM')",
                      "type": "Expression"
                    },
                    "DAY": {
                      "value": "@formatDateTime(utcNow(),'dd')",
                      "type": "Expression"
                    }
                  }
                }
              ]
            },
            {
              "name": "IF_EXCEL_ROWS_COPIED",
              "type": "IfCondition",
              "dependsOn": [
                {
                  "activity": "CP_Excel_To_Raw",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "userProperties": [],
              "typeProperties": {
                "expression": {
                  "value": "@greater(int(activity('CP_Excel_To_Raw').output.rowsCopied),0)",
                  "type": "Expression"
                },
                "ifFalseActivities": [
                  {
                    "name": "FAIL_EMPTY_EXCEL",
                    "type": "Fail",
                    "dependsOn": [],
                    "userProperties": [],
                    "typeProperties": {
                      "message": "Excel file produced zero rows.",
                      "errorCode": "EMPTY_EXCEL"
                    }
                  }
                ]
              }
            },
            {
              "name": "SP_Update_Excel_Snapshot",
              "type": "SqlServerStoredProcedure",
              "dependsOn": [
                {
                  "activity": "IF_EXCEL_ROWS_COPIED",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "userProperties": [],
              "policy": {
                "timeout": "0.00:05:00",
                "retry": 1,
                "retryIntervalInSeconds": 15,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "storedProcedureName": "dbo.ecom_update_watermark",
                "storedProcedureParameters": {
                  "source_type": {
                    "value": {
                      "value": "EXCEL",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "source_name": {
                    "value": {
                      "value": "Azure",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "schema_name": {
                    "value": {
                      "value": "@pipeline().parameters.pSourceFolder",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "table_name": {
                    "value": {
                      "value": "@replace(replace(replace(toLower(item().name),'.xlsx',''),'.xls',''),'_dataset','')",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "watermark_column": {
                    "value": {
                      "value": "SNAPSHOT_LOAD_UTC",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "last_load_value": {
                    "value": {
                      "value": "@utcNow()",
                      "type": "Expression"
                    },
                    "type": "String"
                  }
                }
              },
              "linkedServiceName": {
                "referenceName": "LS_AzureSQLDB",
                "type": "LinkedServiceReference"
              }
            }
          ],
          "batchCount": 3
        }
      }
    ],
    "parameters": {
      "pSourceFolder": {
        "type": "String",
        "defaultValue": "excel_files"
      }
    },
    "annotations": []
  }
}