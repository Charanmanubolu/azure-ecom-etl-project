{
	"name": "PL_BULK_TO_RAW",
	"properties": {
		"activities": [
			{
				"name": "Initialize_Run_Date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vRunDate",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get_Bulk_Files",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Initialize_Run_Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_BULK_CSV",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Filter_Bulk_CSV_Files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get_Bulk_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get_Bulk_Files').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@and(equals(item().type,'File'),endsWith(toLower(item().name),'.csv'))",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Check_Bulk_CSV_Files",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Filter_Bulk_CSV_Files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(length(activity('Filter_Bulk_CSV_Files').output.value),0)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "Fail_No_Bulk_CSV",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": "No CSV files were found in the configured bulk source folder.",
								"errorCode": "BULK_NO_CSV"
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "Copy_Bulk_To_Raw",
							"type": "Copy",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 2,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"wildcardFileName": "*.csv",
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings",
										"skipLineCount": 0
									}
								},
								"sink": {
									"type": "ParquetSink",
									"storeSettings": {
										"type": "AzureBlobFSWriteSettings"
									},
									"formatSettings": {
										"type": "ParquetWriteSettings"
									}
								},
								"enableStaging": false
							},
							"inputs": [
								{
									"referenceName": "DS_BULK_CSV",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "DS_RAW_PARQUET",
									"type": "DatasetReference",
									"parameters": {
										"EntityName": {
											"value": "@pipeline().parameters.pEntityName",
											"type": "Expression"
										},
										"YEAR": {
											"value": "@formatDateTime(utcNow(),'yyyy')",
											"type": "Expression"
										},
										"MONTH": {
											"value": "@formatDateTime(utcNow(),'MM')",
											"type": "Expression"
										},
										"DAY": {
											"value": "@formatDateTime(utcNow(),'dd')",
											"type": "Expression"
										}
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"pEntityName": {
				"type": "String",
				"defaultValue": "@dataset().FileName"
			}
		},
		"variables": {
			"vRunDate": {
				"type": "String"
			}
		},
		"annotations": []
	}
}